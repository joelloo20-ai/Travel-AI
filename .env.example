# Required for AI-generated itineraries. Without it, the server falls back
# to the built-in template generator and the app still works.
ANTHROPIC_API_KEY=

# Port the Express API server (and, in production, the built frontend) runs on.
PORT=8787

# Optional: live-sync every expense to a Google Sheet as it's added.
# Without these, expenses just aren't synced — everything else still works.
# Setup: see the "Google Sheets sync" section in README.md.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: comma-separated list of origins allowed to call this API
# cross-origin (e.g. https://joelloo20-ai.github.io if the frontend is on
# GitHub Pages while this server runs elsewhere). Leave unset to allow any
# origin — fine here since there's no cookie/session auth on this API.
ALLOWED_ORIGINS=

# Frontend build-time only (not read by the server): set this instead of/in
# addition to the above when building the frontend to be served from a
# different origin than the API (e.g. a static GitHub Pages build calling a
# Render-hosted API). Leave unset for local dev (Vite proxies /api for you)
# and for an all-in-one deployment like Render, where the API is same-origin.
VITE_API_BASE=
