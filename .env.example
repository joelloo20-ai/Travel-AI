# Required for AI-generated itineraries. Without it, the server falls back
# to the built-in template generator and the app still works.
ANTHROPIC_API_KEY=

# Port the Express API server (and, in production, the built frontend) runs on.
PORT=8787

# Optional: sync every expense and every trip's full itinerary straight from
# the browser to a Google Sheet, via a Google Apps Script Web App (no
# service account, no server involvement — works even on GitHub Pages).
# Without these, sync just doesn't happen — everything else still works.
# Setup: see the "Google Sheets sync" section in README.md.
# NOTE: these are build-time Vite vars (VITE_*), so they end up readable in
# the shipped JS bundle. That's fine for the shared secret's purpose here
# (a light deterrent against randos finding the URL, not real auth) but
# don't reuse a secret you care about elsewhere.
VITE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_SHARED_SECRET=
